# Copy this file to .env for LOCAL runs only. Never commit the real .env.
# For GitHub Actions, set these as repository secrets instead:
# Settings -> Secrets and variables -> Actions -> New repository secret

# From @BotFather on Telegram after you create a bot with /newbot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Your personal chat id (see README "Telegram setup" section for how to get it)
TELEGRAM_CHAT_ID=123456789

# Optional: override where the SQLite "seen jobs" database lives
# JOB_RADAR_DB_PATH=data/seen_jobs.sqlite3
